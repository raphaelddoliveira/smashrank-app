# Credenciais da Cora (Integração Direta). Gerar com:
#   base64 -w0 ~/.config/cora/certificate.pem
#   base64 -w0 ~/.config/cora/private-key.key
CORA_CERT_B64=
CORA_KEY_B64=
CORA_CLIENT_ID=
# stage: https://matls-clients.api.stage.cora.com.br
# produção: https://matls-clients.api.cora.com.br
CORA_BASE_URL=https://matls-clients.api.stage.cora.com.br

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo combinado com a Cora no cadastro do webhook (opcional, mas use)
WEBHOOK_SECRET=
